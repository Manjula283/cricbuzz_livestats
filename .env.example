# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to git.

# --- Cricbuzz API (RapidAPI) ---
CRICBUZZ_API_KEY=your_rapidapi_key_here
CRICBUZZ_API_HOST=cricbuzz-cricket.p.rapidapi.com

# --- Database ---
# DB_TYPE options: sqlite | mysql | postgres
DB_TYPE=sqlite
SQLITE_DB_PATH=data/cricbuzz.db

# Only needed if DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cricbuzz_livestats
